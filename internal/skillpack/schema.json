{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jekyo.io/schema/jekyo.yaml.json",
  "title": "jekyo.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "app",
    "services"
  ],
  "properties": {
    "app": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$",
      "description": "App name; becomes the Kubernetes namespace."
    },
    "description": {
      "type": "string",
      "description": "One-line description (catalog/dashboard metadata)."
    },
    "icon": {
      "type": "string",
      "description": "Logo URL (catalog/dashboard metadata)."
    },
    "services": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/service"
      }
    },
    "volumes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "size"
        ],
        "properties": {
          "size": {
            "type": "string",
            "description": "PVC size, e.g. 10Gi"
          },
          "class": {
            "type": "string",
            "description": "Storage class (default local-path)"
          },
          "backup": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schedule"
            ],
            "properties": {
              "schedule": {
                "type": "string",
                "description": "Cron expression for snapshots"
              },
              "keep": {
                "type": "integer",
                "minimum": 1,
                "default": 7
              }
            }
          },
          "access": {
            "type": "string",
            "enum": [
              "rwo",
              "rwx"
            ],
            "description": "Claim access mode; default rwo."
          }
        }
      }
    }
  },
  "definitions": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string"
        },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "context": {
              "type": "string",
              "default": "."
            },
            "dockerfile": {
              "type": "string",
              "description": "Dockerfile path (exclusive with inline)"
            },
            "inline": {
              "type": "string",
              "description": "Literal Dockerfile contents (exclusive with dockerfile)"
            },
            "args": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "http": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "domain"
          ],
          "properties": {
            "domain": {
              "type": "string"
            },
            "path": {
              "type": "string",
              "default": "/"
            },
            "tls": {
              "type": "boolean",
              "default": true
            },
            "auth": {
              "type": "string",
              "enum": [
                "basic"
              ]
            },
            "redirect": {
              "type": "string",
              "description": "Answer requests to this domain with a permanent redirect to the given host or URL; the service runs no container and must define nothing else."
            }
          }
        },
        "expose": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "port"
            ],
            "properties": {
              "port": {
                "type": "integer"
              },
              "node": {
                "type": "integer",
                "minimum": 30000,
                "maximum": 32767
              },
              "protocol": {
                "type": "string",
                "enum": [
                  "tcp",
                  "udp"
                ]
              },
              "host": {
                "type": "integer",
                "description": "Publish on this host port (any conventional number; not 80/443/6443)."
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            },
            "cpu-max": {
              "type": "string"
            },
            "memory-max": {
              "type": "string"
            }
          }
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "stateful": {
          "type": "boolean"
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            },
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Exec probe command; mutually exclusive with path."
            },
            "grace": {
              "type": "integer",
              "description": "Startup budget in seconds before liveness applies (default 60)."
            }
          }
        },
        "gpu": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "count": {
                  "type": "integer"
                },
                "devices": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "schedule": {
          "type": "string",
          "description": "Cron expression; makes this service a CronJob."
        },
        "volumes": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "subpath": {
                    "type": "string"
                  }
                },
                "required": [
                  "path"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Env vars delivered via a Kubernetes Secret and secretKeyRef, never inline. Same ${VAR} interpolation as env."
        },
        "files": {
          "type": "object",
          "description": "Mount operator-supplied files: value is a local file path (ConfigMap) or {from, mode} (Secret).",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "mode": {
                    "type": "string"
                  }
                },
                "required": [
                  "from"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "init": {
          "type": "object",
          "description": "Run-to-completion containers before the service starts; inherit env, secrets, volumes.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "image": {
                "type": "string"
              },
              "command": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "command"
            ],
            "additionalProperties": false
          }
        },
        "sidecars": {
          "type": "object",
          "description": "Extra containers in the pod sharing volumes and localhost.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "image": {
                "type": "string"
              },
              "command": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "port": {
                "type": "integer"
              },
              "ports": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "resources": {
                "type": "object"
              },
              "volumes": {
                "type": "object"
              }
            },
            "required": [
              "image"
            ],
            "additionalProperties": false
          }
        },
        "stop-grace": {
          "type": "integer",
          "description": "terminationGracePeriodSeconds."
        },
        "shm": {
          "type": "string",
          "description": "Size of /dev/shm, e.g. 1Gi."
        },
        "caps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Linux capabilities to add, e.g. NET_ADMIN."
        },
        "security": {
          "type": "object",
          "properties": {
            "run-as": {
              "type": "integer"
            },
            "read-only-root": {
              "type": "boolean"
            },
            "no-new-privileges": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "network": {
          "type": "object",
          "properties": {
            "host": {
              "type": "boolean"
            },
            "egress": {
              "type": "string",
              "enum": [
                "restricted",
                "internal"
              ]
            },
            "allow": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "placement": {
          "type": "object",
          "properties": {
            "selector": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "tolerate": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  },
                  "effect": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "metrics": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}